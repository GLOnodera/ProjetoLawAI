# .env.example
# Copie este arquivo para .env e preencha com seus dados reais.
# Nunca faça commit do arquivo .env com dados reais!

# Chave de API da PandaScore
# Obtenha em: https://pandascore.co/ e crie sua key
PANDASCORE_API_KEY= SUA_API_KEY

# Configuração do Flask (opcional)
# "development" ativa o modo debug, "production" para deploy
FLASK_ENV=development
FLASK_DEBUG=1
